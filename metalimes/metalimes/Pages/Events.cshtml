@page
@model EventsModel
@{
    ViewData["Title"] = "Events";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>My Events</h1>
        </div>
        <div class="col-md-4 text-end">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createEventModal">
                <i class="bi bi-plus-circle"></i> Create New Event
            </button>
        </div>
    </div>

    @if (Model.UserEvents.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <p>You have no events yet. <a href="#" data-bs-toggle="modal" data-bs-target="#createEventModal">Create your first event</a>.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Begin Date</th>
                        <th>End Date</th>
                        <th>Created Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in Model.UserEvents)
                    {
                        <tr>
                            <td><strong>@evt.Name</strong></td>
                            <td>@evt.BeginDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@evt.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@evt.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editEventModal" 
                                        onclick="setEditEvent(@evt.Id, '@evt.Name', '@evt.BeginDate.ToString("yyyy-MM-ddTHH:mm")', '@evt.EndDate.ToString("yyyy-MM-ddTHH:mm")')">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@evt.Id" style="display:inline;" 
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Create Event Modal -->
<div class="modal fade" id="createEventModal" tabindex="-1" aria-labelledby="createEventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createEventModalLabel">Create New Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Create">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Event.Name" class="form-label">Event Name *</label>
                        <input asp-for="Event.Name" class="form-control" required />
                        <span asp-validation-for="Event.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Event.BeginDate" class="form-label">Begin Date & Time *</label>
                        <input asp-for="Event.BeginDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="Event.BeginDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Event.EndDate" class="form-label">End Date & Time *</label>
                        <input asp-for="Event.EndDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="Event.EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Event Modal -->
<div class="modal fade" id="editEventModal" tabindex="-1" aria-labelledby="editEventModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editEventModalLabel">Edit Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="EditingEventId" id="editingEventId" />

                    <div class="mb-3">
                        <label asp-for="Event.Name" class="form-label">Event Name *</label>
                        <input asp-for="Event.Name" class="form-control" id="editEventName" required />
                        <span asp-validation-for="Event.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Event.BeginDate" class="form-label">Begin Date & Time *</label>
                        <input asp-for="Event.BeginDate" type="datetime-local" class="form-control" id="editEventBeginDate" required />
                        <span asp-validation-for="Event.BeginDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Event.EndDate" class="form-label">End Date & Time *</label>
                        <input asp-for="Event.EndDate" type="datetime-local" class="form-control" id="editEventEndDate" required />
                        <span asp-validation-for="Event.EndDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Event</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setEditEvent(id, name, beginDate, endDate) {
            document.getElementById('editingEventId').value = id;
            document.getElementById('editEventName').value = name;
            document.getElementById('editEventBeginDate').value = beginDate;
            document.getElementById('editEventEndDate').value = endDate;
        }
    </script>
}
