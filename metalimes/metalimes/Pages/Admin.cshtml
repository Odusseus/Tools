@page
@model AdminModel
@using metalimes.Data
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <p>Welcome, @Model.AdminName!</p>
    <h1>Admin Dashboard</h1>

    <div class="row mt-3">
        <div class="col-md-12">
            <a href="/ConfigurationManagement" class="btn btn-primary">
                <i class="bi bi-gear"></i> Configuration Management
            </a>
            <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-person-plus"></i> New User
            </button>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <h2>All Users</h2>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Created At</th>
                            <th>Decrypted Password</th>
                            <th>Password Status</th>
                            <th>Roles</th>
                            <th>IsActive</th>
                            <th>IsBlocked</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.UsersWithHelper)
                        {
                            var rolesStr = Model.UserRoles.ContainsKey(user.Id) 
                                ? string.Join(",", Model.UserRoles[user.Id].Cast<int>()) 
                                : "";

                            <tr data-roles="@rolesStr">
                                <td>@user.Id</td>
                                <td>@user.Username</td>
                                <td>@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.DecryptedPassword))
                                    {
                                        <code>@user.DecryptedPassword</code>
                                    }
                                    else if (!string.IsNullOrEmpty(user.ErrorMessage))
                                    {
                                        <span class="text-danger">@user.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.DecryptedPassword))
                                    {
                                        <span class="badge bg-success">✓ Decrypted</span>
                                    }
                                    else if (!string.IsNullOrEmpty(user.ErrorMessage))
                                    {
                                        <span class="badge bg-danger">✗ Error</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">-</span>
                                    }
                                </td>
                                <td>
                                    @if (Model.UserRoles.ContainsKey(user.Id) && Model.UserRoles[user.Id].Count > 0)
                                    {
                                        @foreach (var role in Model.UserRoles[user.Id])
                                        {
                                            <span class="badge bg-info me-2">@role.ToString()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No roles</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="badge bg-danger">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">No</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editUserModal" 
                                            onclick="document.getElementById('EditUserId').value = @user.Id; document.getElementById('EditUsername').value = '@user.Username'; document.getElementById('EditPassword').value = ''; document.getElementById('EditIsActive').checked = @user.IsActive.ToString().ToLower(); document.getElementById('EditIsBlocked').checked = @user.IsBlocked.ToString().ToLower(); var isAdmin = @(Model.UserRoles.ContainsKey(user.Id) && Model.UserRoles[user.Id].Contains(Role.Admin) ? "true" : "false"); var activeInput = document.getElementById('EditIsActive'); var blockedInput = document.getElementById('EditIsBlocked'); var activeContainer = activeInput ? activeInput.closest('.mb-3, .form-check, .form-group, .col-md-6, .col-md-12') : null; var blockedContainer = blockedInput ? blockedInput.closest('.mb-3, .form-check, .form-group, .col-md-6, .col-md-12') : null; var activeLabel = document.querySelector('label[for=\'EditIsActive\']'); var blockedLabel = document.querySelector('label[for=\'EditIsBlocked\']'); if (activeContainer) { activeContainer.style.display = isAdmin ? 'none' : ''; } else { if (activeInput) activeInput.style.display = isAdmin ? 'none' : ''; if (activeLabel) activeLabel.style.display = isAdmin ? 'none' : ''; } if (blockedContainer) { blockedContainer.style.display = isAdmin ? 'none' : ''; } else { if (blockedInput) blockedInput.style.display = isAdmin ? 'none' : ''; if (blockedLabel) blockedLabel.style.display = isAdmin ? 'none' : ''; }">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>

                                    @if (!user.IsActive)
                                    {
                                        <form method="post" asp-page-handler="DeleteUser" class="d-inline" onsubmit="return confirm('Delete this user?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <h2>All Logs</h2>
            <div class="table-responsive">
                <table class="table table-striped table-hover table-sm">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Message</th>
                            <th>Level</th>
                            <th>UserId</th>
                            <th>Decrypted Password</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.LogsWithDecrypted)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@log.Message</td>
                                <td><span class="badge bg-info">@log.Level</span></td>
                                <td>@(log.UserId?.ToString() ?? "-")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.DecryptedCode))
                                    {
                                        <code style="font-size: 0.85em;">@log.DecryptedCode</code>
                                    }
                                    else if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <span class="text-danger small">@log.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.DecryptedCode))
                                    {
                                        <span class="badge bg-success">✓</span>
                                    }
                                    else if (!string.IsNullOrEmpty(log.ErrorMessage))
                                    {
                                        <span class="badge bg-danger">✗</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createUserModalLabel">Create New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="NewUsername" class="form-label">Username *</label>
                        <input type="text" class="form-control" id="NewUsername" name="NewUsername" required>
                        <span asp-validation-for="NewUsername" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="NewPassword" class="form-label">Password *</label>
                        <input type="password" class="form-control" id="NewPassword" name="NewPassword" required>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="CreateSelectedRoles" class="form-label">Roles (optional, besides Basic role)</label>
                        <select class="form-select" id="CreateSelectedRoles" name="SelectedRoles" multiple>
                            @foreach (Role role in Enum.GetValues(typeof(Role)))
                            {
                                @if (role != Role.Basic)
                                {
                                    <option value="@((int)role)">@role.ToString()</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Leave empty for Basic role only. Use Ctrl+Click for multiple roles.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success" name="action" value="create">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <input type="hidden" id="EditUserId" name="EditUserId">
                    <div class="mb-3">
                        <label for="EditUsername" class="form-label">Username *</label>
                        <input type="text" class="form-control" id="EditUsername" name="NewUsername" required>
                        <span asp-validation-for="NewUsername" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="EditPassword" class="form-label">New Password (leave blank to keep current)</label>
                        <input type="password" class="form-control" id="EditPassword" name="NewPassword">
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="EditSelectedRoles" class="form-label">Roles</label>
                        <select class="form-select" id="EditSelectedRoles" name="SelectedRoles" multiple required>
                            @foreach (Role role in Enum.GetValues(typeof(Role)))
                            {
                                <option value="@((int)role)">@role.ToString()</option>
                            }
                        </select>
                        <small class="text-muted">Select at least one role. Use Ctrl+Click for multiple roles.</small>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="EditIsActive" name="EditIsActive" />
                        <label class="form-check-label" for="EditIsActive">IsActive</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="EditIsBlocked" name="EditIsBlocked" />
                        <label class="form-check-label" for="EditIsBlocked">IsBlocked</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" name="action" value="update">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Remove Role Form (Hidden) -->
<form id="removeRoleForm" method="post" style="display: none;">
    <input type="hidden" id="RemoveRoleUserId" name="RoleUserId">
    <input type="hidden" id="RemoveRoleValue" name="SelectedRole">
    <input type="hidden" name="action" value="removeRole">
</form>
<script>
    // Handle modal shown event to populate roles
    const editUserModal = document.getElementById('editUserModal');
    if (editUserModal) {
        editUserModal.addEventListener('shown.bs.modal', function() {
            const rolesSelect = document.getElementById('EditSelectedRoles');
            const userIdInput = document.getElementById('EditUserId');
            
            if (rolesSelect && userIdInput && userIdInput.value) {
                const userId = parseInt(userIdInput.value);
                
                // Find the user's row
                const userRow = Array.from(document.querySelectorAll('tbody tr[data-roles]')).find(row => {
                    const idCell = row.querySelector('td:first-child');
                    return idCell && parseInt(idCell.textContent.trim()) === userId;
                });

                // Reset and select roles
                Array.from(rolesSelect.options).forEach(option => option.selected = false);
                
                if (userRow) {
                    const rolesStr = userRow.getAttribute('data-roles') || '';
                    const roles = rolesStr.split(',').map(r => r.trim()).filter(r => r);
                    roles.forEach(roleValue => {
                        const option = Array.from(rolesSelect.options).find(o => o.value === roleValue);
                        if (option) option.selected = true;
                    });
                }
            }
        });
    }
</script>